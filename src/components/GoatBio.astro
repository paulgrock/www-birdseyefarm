---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { format } from 'date-fns';
import SectionTitle from './SectionTitle.astro';

interface Parent {
  name: string;
  link?: string;
}

interface GoatParent {
  name: string;
  link: string;
  sire?: Parent;
  dam?: Parent;
}

interface GoatImage {
  image: ImageMetadata;
  alt: string;
}

interface Props {
  images?: GoatImage[];
  name: string;
  slug: string;
  adgaPedigree: string;
  date: string;
  sire: GoatParent;
  dam: GoatParent;
  copy?: string[];
  showCopy?: boolean;
  withTitle?: boolean;
}

const {
  images = [],
  name,
  slug,
  adgaPedigree,
  date,
  sire,
  dam,
  copy = [],
  showCopy = false,
  withTitle = true
} = Astro.props;

const birthDate = format(new Date(date), 'M/d/yyyy');

// First image is the profile image
const profileImage = images[0];
const additionalImages = images.slice(1);
---

<div class="goat">
  {profileImage && (
    <Image
      src={profileImage.image}
      alt={profileImage.alt}
      class="photo"
      width={380}
    />
  )}

  <header class="content">
    {withTitle && (
      <SectionTitle className="sectionTitle">
        <a href={`/goats/${slug}`}>{name}</a>
      </SectionTitle>
    )}
    <span>Born {birthDate}</span><br />
    <a href={adgaPedigree}>ADGA Pedigree</a>

    <ul class="list">
      <li class="listItem">
        <strong>Sire</strong>: <a href={sire.link}>{sire.name}</a>
      </li>
      {sire.sire && (
        <li class="listItem">
          <strong>SS</strong>: {sire.sire.link ? (
            <a href={sire.sire.link}>{sire.sire.name}</a>
          ) : sire.sire.name}
        </li>
      )}
      {sire.dam && (
        <li class="listItem">
          <strong>SD</strong>: {sire.dam.link ? (
            <a href={sire.dam.link}>{sire.dam.name}</a>
          ) : sire.dam.name}
        </li>
      )}
      <li class="listItem">
        <strong>Dam</strong>: <a href={dam.link}>{dam.name}</a>
      </li>
      {dam.sire && (
        <li class="listItem">
          <strong>DS</strong>: {dam.sire.link ? (
            <a href={dam.sire.link}>{dam.sire.name}</a>
          ) : dam.sire.name}
        </li>
      )}
      {dam.dam && (
        <li class="listItem">
          <strong>DD</strong>: {dam.dam.link ? (
            <a href={dam.dam.link}>{dam.dam.name}</a>
          ) : dam.dam.name}
        </li>
      )}
    </ul>
  </header>

  {showCopy && copy.map((content) => (
    <p class="bodyContent" set:html={content} />
  ))}
  <!-- Note: set:html is used here for content from trusted CMS sources only.
       Content is pre-processed in getStaticPaths and should never include user input. -->

  {showCopy && additionalImages.map(({ image, alt }) => (
    <Image
      src={image}
      alt={alt}
      class="photo"
      width={380}
    />
  ))}
</div>

<style>
  .container {
    background-image: url('../images/goats-bg.jpg');
    padding-top: 120px;
    gap: 2.5rem;
  }

  .goat {
    border-top: 8px solid var(--color-dark-purple);
    background-color: #fff;
    text-align: left;
  }

  .goatList .goat {
    display: flex;
    flex-direction: column;
  }

  .photo {
    margin-bottom: 0;
    display: inline-block;
    vertical-align: middle;
    max-width: 380px;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  @media screen and (min-width: 960px) {
    .goatList .goat {
      flex-direction: row;
    }
    .photo {
      width: 33%;
    }
  }

  .content {
    display: inline-block;
    padding: 34px 34px 0 34px;
    text-align: left;
    vertical-align: top;
  }

  .list {
    list-style-type: none;
    margin: 0;
  }

  .listItem {
    margin-bottom: 0;
  }

  .bodyContent {
    padding-left: 34px;
    padding-right: 34px;
    margin-top: 1rem;
  }

  .bodyContent + .bodyContent {
    margin-top: 0;
  }

  /* Inline images inserted via set:html need :global() */
  .bodyContent :global(img.photo) {
    margin-bottom: 0;
    display: inline-block;
    vertical-align: middle;
    max-width: 380px;
    width: 100%;
    height: auto;
    object-fit: contain;
  }
</style>
