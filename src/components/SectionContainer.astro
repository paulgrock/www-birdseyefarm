---
interface Props {
  className?: string
  id?: string
  [key: string]: any
}

const { className = '', ...rest } = Astro.props
---

<section class={`container ${className}`} {...rest}>
  <slot />
</section>

<style>
  .container {
    background-color: rgba(76, 40, 81, 0.3);
    background-position: center center;
    background-repeat: no-repeat;
    background-size: cover;
    display: grid;
    padding: 62px 8.47%;
  }
</style>
