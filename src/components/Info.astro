---
import SectionTitle from './SectionTitle.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="heading">
  <SectionTitle className="sectionTitle">{title}</SectionTitle>
  <slot />
</div>

<style>
  .heading {
    grid-column: 1 / -1;
    color: var(--color-darker-purple);
    background-color: rgba(255, 255, 255, .3);
    padding: 0 1em;
  }

  .heading p {
    text-align: left;
    text-indent: 2em;
  }
</style>
