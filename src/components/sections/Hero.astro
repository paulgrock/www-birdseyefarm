---
import { Image } from 'astro:assets';
import SectionContainer from '../SectionContainer.astro';
import * as styles from './hero.module.css';
import logo from '../../images/logo-large.png';
import homeBackground from '../../images/home.jpg';
---

<SectionContainer className={styles.heroContainer}>
  <div class={styles.bgi} style={`background-image: url(${homeBackground.src})`}></div>
  <Image src={logo} alt="Bird's Eye Farm" class={styles.logo} width={400} height={400} />
</SectionContainer>
