---
import SectionContainer from '../SectionContainer.astro'
import SectionTitle from '../SectionTitle.astro'
import Button from '../Button.astro'
import { sanityClient } from '../../lib/sanity'
import { deliveriesPageQuery } from '../../lib/queries'
import { formatPrice, getDeliveryItems } from '../../lib/deliveries'
import type { DeliveriesPage } from '../../types/sanity'

const deliveriesPage = await sanityClient.fetch<DeliveriesPage | null>(
  deliveriesPageQuery
)
const items = getDeliveryItems(deliveriesPage)
const venmoUsername =
  deliveriesPage?.venmoUsername?.trim().replace(/^@/, '') ?? ''
const paymentNote =
  deliveriesPage?.paymentNote ??
  'Select items for your order here. Pay by Venmo or cash.'
---

<SectionContainer id="deliveries" className="container">
  <header>
    <SectionTitle>Deliveries</SectionTitle>
    <p>{paymentNote}</p>
  </header>

  <form
    method="post"
    class="form"
    data-netlify="true"
    name="deliveries"
    netlify-honeypot="botField"
    data-venmo={venmoUsername}
  >
    <input type="hidden" name="form-name" value="deliveries" />
    <input type="hidden" name="order" value="" />
    <input type="hidden" name="total" value="" />
    <input type="hidden" name="paymentMethod" value="" />

    <div hidden>
      <label>Don't fill this out: <input name="botField" /></label>
    </div>

    <fieldset class="items">
      <legend class="sr-only">Delivery items</legend>

      {
        items.map((item, index) => (
          <div class="item">
            <label class="item-info" for={`qty-${index}`}>
              <span class="item-name">{item.name}</span>
              <span class="item-price">
                {typeof item.price === 'number'
                  ? `${formatPrice(item.price)}${item.unit ? ` / ${item.unit}` : ''}`
                  : 'Price varies'}
              </span>
              {item.description && (
                <span class="item-description">{item.description}</span>
              )}
            </label>
            <div class="stepper">
              <button
                type="button"
                class="step"
                data-step="-1"
                aria-label={`Fewer ${item.name}`}
              >
                −
              </button>
              <input
                id={`qty-${index}`}
                class="qty"
                type="number"
                inputmode="numeric"
                min="0"
                step="1"
                value="0"
                data-name={item.name}
                data-price={typeof item.price === 'number' ? item.price : ''}
                data-unit={item.unit ?? ''}
              />
              <button
                type="button"
                class="step"
                data-step="1"
                aria-label={`More ${item.name}`}
              >
                +
              </button>
            </div>
          </div>
        ))
      }
    </fieldset>

    <p class="total" aria-live="polite">
      Total: <strong id="order-total">$0</strong>
      <span id="varies-note" class="varies-note" hidden>
        + items priced at delivery
      </span>
    </p>

    <p id="items-error" class="items-error" role="alert" hidden>
      Please choose at least one item.
    </p>

    <input
      placeholder="Email Address"
      type="email"
      name="email"
      class="input"
      required
      aria-label="Email Address"
    />

    <input
      placeholder="Location"
      type="text"
      name="location"
      class="input"
      required
      aria-label="Location"
    />

    <textarea
      name="message"
      class="textarea"
      placeholder="Anything else?"
      aria-label="Anything else?"></textarea>

    <div class="pay-buttons">
      {
        venmoUsername && (
          <Button
            type="submit"
            id="venmo-submit"
            className="venmo-button"
            data-method="venmo"
            disabled
          >
            Pay with Venmo
          </Button>
        )
      }
      <Button type="submit" className="cash-button" data-method="cash">
        Pay cash on delivery
      </Button>
    </div>
  </form>

  <dialog id="success-dialog" class="modal">
    <div class="modal-content">
      <p>Thank you! Your order has been received.</p>
      <p id="success-message"></p>
      <a id="venmo-link" class="venmo-link" hidden>Open Venmo</a>
      <Button id="close-dialog">Close</Button>
    </div>
  </dialog>

  <dialog id="error-dialog" class="modal">
    <div class="modal-content">
      <p>
        Sorry, there was an error submitting your request. Please try again or
        email us directly.
      </p>
      <Button id="close-error-dialog">Close</Button>
    </div>
  </dialog>
</SectionContainer>

<script>
  type CartLine = {
    name: string
    qty: number
    price: number | null
    unit: string
  }

  type Cart = {
    lines: CartLine[]
    total: number
    hasUnpricedItems: boolean
  }

  type PaymentMethod = 'venmo' | 'cash'

  const formatMoney = (amount: number) =>
    Number.isInteger(amount) ? `$${amount}` : `$${amount.toFixed(2)}`

  const form = document.querySelector(
    'form[name="deliveries"]'
  ) as HTMLFormElement
  const successDialog = document.getElementById(
    'success-dialog'
  ) as HTMLDialogElement
  const errorDialog = document.getElementById(
    'error-dialog'
  ) as HTMLDialogElement
  const closeBtn = document.getElementById('close-dialog')
  const closeErrorBtn = document.getElementById('close-error-dialog')
  const totalEl = document.getElementById('order-total')
  const variesNote = document.getElementById('varies-note')
  const itemsError = document.getElementById('items-error')
  const successMessage = document.getElementById('success-message')
  const venmoLink = document.getElementById('venmo-link') as HTMLAnchorElement
  const venmoButton = document.getElementById(
    'venmo-submit'
  ) as HTMLButtonElement | null

  const qtyInputs = () =>
    Array.from(form.querySelectorAll<HTMLInputElement>('input.qty'))

  function readCart(): Cart {
    const lines: CartLine[] = qtyInputs()
      .map((input) => {
        const qty = Math.max(0, Math.floor(Number(input.value) || 0))
        const price = input.dataset.price ? Number(input.dataset.price) : null
        return {
          name: input.dataset.name ?? '',
          qty,
          price,
          unit: input.dataset.unit ?? '',
        }
      })
      .filter((line) => line.qty > 0)

    const total =
      Math.round(
        lines.reduce((sum, line) => sum + (line.price ?? 0) * line.qty, 0) * 100
      ) / 100

    return {
      lines,
      total,
      hasUnpricedItems: lines.some((line) => line.price === null),
    }
  }

  function describeOrder(cart: Cart): string {
    return cart.lines
      .map((line) =>
        line.price === null
          ? `${line.qty} × ${line.name} (price varies)`
          : `${line.qty} × ${line.name} @ ${formatMoney(line.price)}${
              line.unit ? `/${line.unit}` : ''
            } = ${formatMoney(line.price * line.qty)}`
      )
      .join('; ')
  }

  function shortNote(cart: Cart): string {
    const items = cart.lines
      .map((line) => `${line.qty} ${line.name}`)
      .join(', ')
    return `Bird's Eye Farm delivery: ${items}`
  }

  // Venmo payment link with the amount and order note prefilled.
  // To add another method (e.g. Stripe), add a button with its own
  // data-method and handle it in the submit listener below.
  function venmoUrl(cart: Cart): string {
    const params = new URLSearchParams({
      txn: 'pay',
      amount: cart.total.toFixed(2),
      note: shortNote(cart),
    })
    return `https://venmo.com/${encodeURIComponent(
      form.dataset.venmo ?? ''
    )}?${params.toString().replace(/\+/g, '%20')}`
  }

  function updateTotal() {
    const cart = readCart()
    if (totalEl) totalEl.textContent = formatMoney(cart.total)
    if (variesNote) variesNote.hidden = !cart.hasUnpricedItems
    if (itemsError && cart.lines.length > 0) itemsError.hidden = true
    if (venmoButton) {
      venmoButton.disabled = cart.total <= 0
      venmoButton.textContent =
        cart.total > 0
          ? `Pay ${formatMoney(cart.total)} with Venmo`
          : 'Pay with Venmo'
    }
  }

  function renderSuccess(cart: Cart, method: PaymentMethod) {
    const extra = cart.hasUnpricedItems ? ' plus items priced at delivery' : ''
    if (method === 'venmo') {
      const url = venmoUrl(cart)
      venmoLink.href = url
      venmoLink.hidden = false
      if (successMessage)
        successMessage.textContent = `Opening Venmo to pay ${formatMoney(
          cart.total
        )}${extra}. If it doesn't open, tap the link below.`
      return url
    }
    venmoLink.hidden = true
    if (successMessage)
      successMessage.textContent =
        cart.total > 0
          ? `Your total is ${formatMoney(cart.total)}${extra}. Please have cash ready at delivery.`
          : 'We will let you know the total at delivery.'
    return null
  }

  if (form && successDialog && errorDialog && closeBtn && closeErrorBtn) {
    form.addEventListener('click', (e) => {
      const button = (e.target as HTMLElement).closest<HTMLButtonElement>(
        'button.step'
      )
      if (!button) return
      const input =
        button.parentElement?.querySelector<HTMLInputElement>('input.qty')
      if (!input) return
      const next = (Number(input.value) || 0) + Number(button.dataset.step)
      input.value = String(Math.max(0, next))
      updateTotal()
    })

    form.addEventListener('input', (e) => {
      if ((e.target as HTMLElement).classList.contains('qty')) updateTotal()
    })

    form.addEventListener('submit', async (e) => {
      e.preventDefault()

      const submitter = (e as SubmitEvent).submitter as HTMLElement | null
      const method: PaymentMethod =
        submitter?.dataset.method === 'venmo' ? 'venmo' : 'cash'

      const cart = readCart()
      if (cart.lines.length === 0) {
        if (itemsError) itemsError.hidden = false
        itemsError?.scrollIntoView({ behavior: 'smooth', block: 'center' })
        return
      }

      const orderInput = form.elements.namedItem('order') as HTMLInputElement
      const totalInput = form.elements.namedItem('total') as HTMLInputElement
      orderInput.value = describeOrder(cart)
      totalInput.value = `${formatMoney(cart.total)}${
        cart.hasUnpricedItems ? ' + items priced at delivery' : ''
      }`
      const methodInput = form.elements.namedItem(
        'paymentMethod'
      ) as HTMLInputElement
      methodInput.value = method === 'venmo' ? 'Venmo' : 'Cash on delivery'

      const formData = new FormData(form)
      const params = new URLSearchParams()
      formData.forEach((value, key) => {
        params.append(key, value.toString())
      })
      const body = params.toString()

      try {
        const response = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: body,
        })

        if (response.ok) {
          const payUrl = renderSuccess(cart, method)
          successDialog.showModal()
          form.reset()
          updateTotal()
          if (payUrl) window.location.href = payUrl
        } else {
          throw new Error('Form submission failed')
        }
      } catch (error) {
        errorDialog.showModal()
      }
    })

    closeBtn.addEventListener('click', () => successDialog.close())
    closeErrorBtn.addEventListener('click', () => errorDialog.close())

    successDialog.addEventListener('click', (e) => {
      if (e.target === successDialog) {
        successDialog.close()
      }
    })

    errorDialog.addEventListener('click', (e) => {
      if (e.target === errorDialog) {
        errorDialog.close()
      }
    })
  }
</script>

<style>
  .form :global(.button) {
    margin-top: 28px;
  }

  .pay-buttons :global(.button + .button) {
    margin-top: 12px;
  }

  .pay-buttons :global(.venmo-button) {
    background: #008cff;
    border-color: #008cff;
    cursor: pointer;
  }

  .pay-buttons :global(.venmo-button:disabled) {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .pay-buttons :global(.cash-button) {
    cursor: pointer;
  }

  .pay-buttons :global(.button:not(:disabled):hover) {
    opacity: 0.9;
  }

  .container {
    background-color: var(--color-dark-purple);
    grid-template-columns: 1fr auto 1fr;
    min-height: auto;
    padding-top: 120px;
    background-image: url('../../images/bg.svg');
  }

  header {
    color: white;
    grid-column: 1 / -1;
    text-align: center;
  }

  .form {
    grid-column: 2;
    min-width: 300px;
    max-width: 400px;
  }

  .items {
    border: none;
    padding: 0;
    margin: 0;
  }

  .item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: white;
  }

  .item + .item {
    margin-top: 20px;
  }

  .item-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .item-price,
  .item-description {
    font-size: 0.9em;
    opacity: 0.8;
  }

  .stepper {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .step {
    width: 36px;
    height: 36px;
    border: 2px solid white;
    background: transparent;
    color: white;
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
  }

  .step:hover {
    background: rgba(255, 255, 255, 0.15);
  }

  .qty {
    width: 48px;
    height: 36px;
    border: none;
    text-align: center;
    color: var(--color-darker-purple);
    -moz-appearance: textfield;
    appearance: textfield;
  }

  .qty::-webkit-outer-spin-button,
  .qty::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .total {
    color: white;
    margin-top: 32px;
    font-size: 1.2em;
  }

  .varies-note:not([hidden]) {
    display: block;
    font-size: 0.75em;
    opacity: 0.8;
  }

  .items-error {
    color: #ffd2d2;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .input,
  .textarea {
    display: block;
    width: 100%;
    -webkit-appearance: none;
    appearance: none;
    border: none;
    padding: 10px;
    color: var(--color-darker-purple);
  }

  .total + .input,
  .items-error + .input,
  .input + .input,
  .textarea {
    margin-top: 43px;
  }

  .modal {
    margin: auto;
    border: none;
    padding: 0;
    max-width: calc(100vw - 32px);
  }

  .modal-content {
    background-color: white;
    padding: 50px;
  }

  .venmo-link:not([hidden]) {
    display: block;
    margin-bottom: 20px;
    color: var(--color-dark-purple);
    font-weight: bold;
  }

  dialog::backdrop {
    background-color: rgba(0, 0, 0, 0.75);
  }

  dialog button:hover {
    opacity: 0.9;
  }
</style>
