---
import SectionContainer from '../SectionContainer.astro';
import Button from '../Button.astro';
---

<SectionContainer id="deliveries" className="container">
  <h3 class="title">Let us know which delivery options interest you.</h3>

  <form
    method="post"
    class="form"
    data-netlify="true"
    name="deliveries"
    netlify-honeypot="botField"
  >
    <input type="hidden" name="form-name" value="deliveries" />

    <div hidden>
      <label>Don't fill this out: <input name="botField" /></label>
    </div>

    <fieldset class="options">
      <legend class="sr-only">Delivery options</legend>

      <label class="checkbox">
        <input
          type="checkbox"
          name="deliveryOptions"
          value="Dozen-A-Week 🍳 Subscription ($24/month)"
        />
        <span>Dozen-A-Week 🍳 Subscription ($24/month)</span>
      </label>

      <label class="checkbox">
        <input
          type="checkbox"
          name="deliveryOptions"
          value="Now-and-Then Eggs ($8/doz)"
        />
        <span>Now-and-Then Eggs ($8/doz)</span>
      </label>

      <label class="checkbox">
        <input
          type="checkbox"
          name="deliveryOptions"
          value="Honey, seasonal fruit & veggies, etc."
        />
        <span>Honey, seasonal fruit &amp; veggies, etc.</span>
      </label>
    </fieldset>

    <input
      placeholder="Email Address"
      type="email"
      name="email"
      class="input"
      required
      aria-label="Email Address"
    />

    <input
      placeholder="Location"
      type="text"
      name="location"
      class="input"
      required
      aria-label="Location"
    />

    <textarea
      name="message"
      class="textarea"
      placeholder="anything else?"
      aria-label="Anything else?"
    />

    <Button type="submit">
      Send
    </Button>
  </form>

  <dialog id="success-dialog" class="modal">
    <p>Thanks for your interest! We'll be in touch shortly about deliveries.</p>
    <Button id="close-dialog">Close</Button>
  </dialog>

  <dialog id="error-dialog" class="modal">
    <p>Sorry, there was an error submitting your request. Please try again or email us directly.</p>
    <Button id="close-error-dialog">Close</Button>
  </dialog>
</SectionContainer>

<script>
  const form = document.querySelector('form[name="deliveries"]') as HTMLFormElement;
  const successDialog = document.getElementById('success-dialog') as HTMLDialogElement;
  const errorDialog = document.getElementById('error-dialog') as HTMLDialogElement;
  const closeBtn = document.getElementById('close-dialog');
  const closeErrorBtn = document.getElementById('close-error-dialog');

  if (form && successDialog && errorDialog && closeBtn && closeErrorBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const params = new URLSearchParams();
      formData.forEach((value, key) => {
        params.append(key, value.toString());
      });
      const body = params.toString();

      try {
        const response = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: body
        });

        if (response.ok) {
          successDialog.showModal();
          form.reset();
        } else {
          throw new Error('Form submission failed');
        }
      } catch (error) {
        errorDialog.showModal();
      }
    });

    closeBtn.addEventListener('click', () => successDialog.close());
    closeErrorBtn.addEventListener('click', () => errorDialog.close());

    successDialog.addEventListener('click', (e) => {
      if (e.target === successDialog) {
        successDialog.close();
      }
    });

    errorDialog.addEventListener('click', (e) => {
      if (e.target === errorDialog) {
        errorDialog.close();
      }
    });
  }
</script>

<style>
  .form :global(.button) {
    margin-top: 28px;
  }

  .container {
    background-color: var(--color-dark-purple);
    grid-template-columns: 1fr auto 1fr;
    min-height: auto;
    padding-top: 120px;
    background-image: url('../../images/bg.svg');
  }

  .title {
    color: white;
    grid-column: 1 / -1;
    text-align: center;
  }

  .form {
    grid-column: 2;
    min-width: 300px;
    max-width: 400px;
  }

  .options {
    border: none;
    padding: 0;
    margin: 0;
  }

  .checkbox {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: white;
    cursor: pointer;
  }

  .checkbox + .checkbox {
    margin-top: 16px;
  }

  .checkbox input {
    margin-top: 4px;
    flex-shrink: 0;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .input,
  .textarea {
    display: block;
    width: 100%;
    -webkit-appearance: none;
    appearance: none;
    border: none;
    padding: 10px;
    color: var(--color-darker-purple);
  }

  .options + .input,
  .input + .input,
  .textarea {
    margin-top: 43px;
  }

  .modal {
    margin: auto;
    background-color: white;
    padding: 50px;
  }

  .overlay {
    display: grid;
    z-index: 10000;
    position: fixed;
    background-color: rgba(0, 0, 0, .75);
    height: 100vh;
    width: 100vw;
    top: 0;
    left: 0;
  }

  dialog {
    border: none;
    padding: 0;
  }

  dialog::backdrop {
    background-color: rgba(0, 0, 0, 0.75);
  }

  dialog button:hover {
    opacity: 0.9;
  }
</style>
