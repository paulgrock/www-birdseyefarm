---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import SectionContainer from '../../components/SectionContainer.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import GoatBio from '../../components/GoatBio.astro';
import { getGoatImages } from '../../utils/imageHelpers';
import * as goatStyles from '../../components/goats.module.css';

export async function getStaticPaths() {
  const goats = await getCollection('goats');

  return goats.map((goat) => ({
    params: { slug: goat.id },
    props: { goat }
  }));
}

const { goat } = Astro.props;
const images = await getGoatImages(goat.id, goat.data.images);

// Process copy to replace inline image paths with optimized versions
let processedCopy = goat.data.copy;
if (processedCopy && images.length > 0) {
  processedCopy = await Promise.all(
    processedCopy.map(async (paragraph: string) => {
      let processed = paragraph;

      // Replace inline image references with optimized versions for any goat
      for (const { image, alt } of images) {
        // Extract filename from image path (handles various Astro image formats)
        const imageName = alt.toLowerCase().includes('young') ? 'young' :
                         alt.toLowerCase().includes('udder') ? 'udder' : null;

        if (imageName) {
          const optimized = await getImage({ src: image, width: 380 });
          // Replace common inline image patterns
          processed = processed.replace(new RegExp(`/${goat.id.split('/').pop()}-${imageName}[^"']*\.(jpg|png|webp)`, 'g'), optimized.src);
          processed = processed.replace(new RegExp(`/nib-${imageName}[^"']*\.(jpg|png|webp)`, 'g'), optimized.src);
        }
      }

      return processed;
    })
  );
}
---

<Layout
  title={goat.data.name}
  description={`Information about ${goat.data.name}, a Nigerian Dwarf Goat`}
>
  <SectionContainer className={goatStyles.container}>
    <SectionTitle>{goat.data.name}</SectionTitle>
    <GoatBio
      images={images}
      name={goat.data.name}
      slug={goat.data.slug}
      adgaPedigree={goat.data.adgaPedigree}
      date={goat.data.date}
      sire={goat.data.sire}
      dam={goat.data.dam}
      copy={processedCopy}
      showCopy={true}
      withTitle={false}
    />
  </SectionContainer>
</Layout>
