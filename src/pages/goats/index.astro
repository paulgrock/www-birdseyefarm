---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SectionContainer from '../../components/SectionContainer.astro';
import Info from '../../components/Info.astro';
import GoatBio from '../../components/GoatBio.astro';
import { getGoatImages } from '../../utils/imageHelpers';

const goats = await getCollection('goats');

const goatOrder = [
  'birds-eye-farm-ina-may',
  'diji-farm-cacao-nib',
  'birds-eye-farm-elena-ferrante',
  'birds-eye-farm-lizabeth-darcy',
  'birds-eye-farm-masha-gessen',
  'birds-eye-farm-gianaclis',
  'birds-eye-farm-gilia-tricolor',
  'birds-eye-farm-vanilla-orchid',
  'birds-eye-farm-zora-neale',
  'harley-hillside-ginger-zinger',
  'harley-hillside-dime-piece',
];

const sortedGoats = goatOrder.map(slug => goats.find(g => g.id === slug)).filter(Boolean);

// Load all images for all goats
const goatsWithImages = await Promise.all(
  sortedGoats.map(async (goat) => {
    const images = await getGoatImages(goat.id, goat.data.images);
    return { ...goat, images };
  })
);
---

<Layout title="Nigerian Dwarf Goats">
  <SectionContainer className="container goatList">
    <Info title="Does">
      <p>
        We keep a small herd of ADGA registered Nigerian Dwarf dairy goats,
        the pride and joy of Bird's Eye Farm. Goats were among the first
        species domesticated by humans—at the dawn of agriculture, some
        10,000 years ago—and it's no wonder. Humans just thrive better with
        goats around.
      </p>
      <p>
        Excellent milk production is our priority, and we carefully limit herd size so we can have close, affectionate working relationships with our milkers. We specialize in extended lactations, breeding in alternate years and milking through to keep supply going in the off years. We've been pleased to see how well our does perform on this schedule—see their individual doe pages for details.
      </p>
      <p>
        Our herd tested negative for CAE, CL, OPP and Johne's as of October
        2025.
      </p>
    </Info>

    {goatsWithImages.map((goat) => (
      <GoatBio
        images={goat.images}
        name={goat.data.name}
        slug={goat.data.slug}
        adgaPedigree={goat.data.adgaPedigree}
        date={goat.data.date}
        sire={goat.data.sire}
        dam={goat.data.dam}
        withTitle={true}
        showCopy={false}
      />
    ))}
  </SectionContainer>
</Layout>

<style>
  .container {
    background-image: url('../../images/goats-bg.jpg');
    padding-top: 120px;
    gap: 2.5rem;
  }

  .goatList :global(.goat) {
    display: flex;
    flex-direction: column;
  }

  @media screen and (min-width: 960px) {
    .goatList :global(.goat) {
      flex-direction: row;
    }
  }
</style>
